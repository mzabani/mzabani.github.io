// Shared page template for the Typst-generated HTML site.
// Styling lives entirely here (in the <style> block) rather than in
// external CSS files - this replaces css/default.css and css/syntax.css.

#let style = "
:root {
  color-scheme: light dark;
  --bg: #ffffff;
  --fg: #1a1a1a;
  --muted: #666666;
  --border: #dddddd;
  --code-bg: #f5f5f5;
  --link: #0056b3;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #16181c;
    --fg: #e6e6e6;
    --muted: #9a9a9a;
    --border: #3a3d42;
    --code-bg: #1f2226;
    --link: #6cb2ff;
  }
}
* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;
  line-height: 1.6;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 1.25rem;
}
a { color: var(--link); }
header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 2px solid var(--fg);
  margin-bottom: 2rem;
  padding: 1rem 0;
}
header a.logo { font-weight: bold; font-size: 1.1rem; text-decoration: none; color: var(--fg); }
header nav a { margin-left: 1rem; text-decoration: none; font-weight: bold; text-transform: uppercase; font-size: 0.9rem; color: var(--fg); }
h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }
h2 { font-size: 1.3rem; margin-top: 2rem; }
h3 { font-size: 1.1rem; }
.info { color: var(--muted); font-size: 0.85rem; font-style: italic; margin-bottom: 1.5rem; }
pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  overflow-x: auto;
  font-size: 0.85rem;
}
code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
p code, li code { background: var(--code-bg); padding: 0.1em 0.3em; border-radius: 4px; }
table { border-collapse: collapse; margin: 1.5rem 0; width: 100%; }
table, th, td { border: 1px solid var(--border); }
th, td { padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
ul#post-list li { margin-bottom: 0.5rem; }
footer {
  border-top: 2px solid var(--border);
  color: var(--muted);
  font-size: 0.8rem;
  margin-top: 3rem;
  padding: 1rem 0;
  text-align: right;
}
section[role=\"doc-endnotes\"] { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: 0.5rem; font-size: 0.9rem; color: var(--muted); }
"

#let page(title: "", subtitle: none, home: false, body) = {
  set document(title: "Marcelo Zabani's Blog - " + title)
  html.elem("style", style)
  html.elem("header")[
    #html.elem("a", attrs: (class: "logo", href: if home { "./" } else { "../" }))[Marcelo Zabani's Blog]
    #html.elem("nav")[#html.elem("a", attrs: (href: if home { "./" } else { "../" }))[Home]]
  ]
  html.elem("main")[
    #html.elem("h1")[#title]
    #if subtitle != none [
      #html.elem("div", attrs: (class: "info"))[#subtitle]
    ]
    #body
  ]
  html.elem("footer")[
    Site generated by #link("https://typst.app")[Typst]
  ]
}
